{
  "manifest_version": 3,
  "name": "Seensy",
  "version": "0.1.0",
  "description": "See who opened your email and which links they clicked, without counting your own views.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "cookies",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://seensy-api.mridulchdry.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Seensy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/track-on.svg",
        "icons/track-off.svg"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
